<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 🟢 AQUÍ AGREGAMOS LOS PERMISOS PARA LA CÁMARA Y LA GALERÍA -->
    <!-- Permiso para usar la cámara física del celular -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Le avisa al sistema que usaremos la cámara pero no es obligatoria para instalar la app -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Permisos para leer imágenes de la galería (Para Android 13 o superior) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Permiso de respaldo para la galería en celulares con Android antiguo (12 o inferior) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IroZumi">

        <activity
            android:name="com.irozumi.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.IroZumi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🟢 PROVIDER DE ARCHIVOS (Evita que la app crashee al compartir fotos entre la cámara y tu app) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" tools:node="replace" />
        </provider>

    </application>

</manifest>